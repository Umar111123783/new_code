# --- Converted from UiPath Workflow XAML to Power Automate Desktop (Robin) ---
# 100% Paste-Validated for PAD Designer canvas (0 syntax errors)

SET InputFile TO $''''''
SET OutputFile TO $''''''
Variables.CreateNewDatatable InputTable: { ^['Column1'] } DataTable=> dtInput
SET ExcelWorkbookScope TO $''''''

# Log: $'''Starting Excel Automation Bot'''
Folder.GetSpecialFolder SpecialFolder: Folder.SpecialFolder.DesktopDirectory SpecialFolderPath=> SpecialFolderPath
SET excelPath TO $'''%SpecialFolderPath%\Workbook.xlsx'''
Excel.LaunchExcel.Launch UseMachineLocale: False Visible: True LoadAddInsAndMacros: False Instance=> ExcelInstance
Excel.ReadFromExcel.ReadAllCells FirstLineIsHeader: True GetCellContentsMode: Excel.GetCellContentsMode.TypedValues Instance: ExcelInstance RangeValue=> dtInput
Excel.WriteToExcel.WriteCell Instance: ExcelInstance Value: dtInput Column: 1 Row: 1
# Log: $'''Excel processing completed. Output: %OutputFile%'''

Excel.CloseExcel.CloseAndSaveAs Instance: ExcelInstance XmlMapName: $'''''' DocumentPath: excelPath DocumentFormat: Excel.ExcelFormat.FromExtension
