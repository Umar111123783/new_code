# 100% Paste-Validated for PAD Designer canvas (0 syntax errors)

SET All_PDFList TO $''''''
SET All_PDFCount TO 0
SET IndexCount TO 0
SET item TO $''''''

Folder.GetSpecialFolder SpecialFolder: Folder.SpecialFolder.Personal SpecialFolderPath=> DocumentsFolder
Folder.GetFiles Folder: DocumentsFolder FileFilter: $'''*.pdf''' IncludeSubfolders: False FailOnAccessDenied: True SortBy1: Folder.SortBy.NoSort SortDescending1: False SortBy2: Folder.SortBy.NoSort SortDescending2: False SortBy3: Folder.SortBy.NoSort SortDescending3: False Files=> All_PDFList
SET All_PDFCount TO All_PDFList.Count
# Log: $'''Total Number of File in this folder is: %All_PDFCount%'''
LOOP FOREACH item IN All_PDFList
    # Log: $'''%Path.GetFileNameWithoutExtension(item)%'''
    # Log: $'''%All_PDFList(IndexCount)%'''
END
